{
  "name": "masjid-website-kit",
  "version": "1.0.0",
  "description": "Website, entrance-TV screen and admin panel for a masjid: prayer times (Mawaqit), Jumu'ah, events calendar, announcements, madrasah and donations. Payload CMS + Next.js, with an MCP endpoint for managing content from Claude.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/plugin-mcp": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "payload": "3.94.1",
    "payload-totp": "3.0.7",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.34.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": "^20.9.0 || >=22.0.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "better-sqlite3"
    ]
  }
}
