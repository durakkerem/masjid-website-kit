# Copy to .env and fill in. Never commit .env.

# The SQLite database file (back it up! see docs/BACKUPS.md)
DATABASE_URI=file:./masjid.db

# Long random string used to sign logins. Generate one with:  openssl rand -hex 32
PAYLOAD_SECRET=

# Your masjid's timezone (IANA name). Used for every date and time on the site and TV.
NEXT_PUBLIC_SITE_TIMEZONE=Europe/London

# Name shown in authenticator apps next to the 2FA code.
TOTP_ISSUER=Masjid website

# Optional: other websites allowed to read the public API from a browser, comma-separated.
# CORS_ORIGINS=https://partner-site.example,https://another.example
